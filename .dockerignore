# Everything that must not reach the build context.
# Keeping this tight matters: anything listed here is hashed on every build and
# a stale host-side build/ or root *.jar can silently end up in the image.

# Build outputs / tool state
build/
out/
bin/
.gradle/
.kotlin/
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Runtime state (bind-mounted at run time, never baked in)
data/
logs/

# VCS & tooling
**/.git
**/.gitignore
**/.gitattributes
**/.github
**/.env
**/.idea
**/.vs
**/.vscode
**/.settings
**/.classpath
**/.project
**/*.iml
**/*.ipr
**/*.iws

# Docker & docs
**/Dockerfile*
**/.dockerignore
**/docker-compose*
**/compose.y*ml
**/charts
LICENSE.md
README.md

# Misc
**/.DS_Store
**/node_modules
**/npm-debug.log
**/secrets.dev.yaml
**/values.dev.yaml